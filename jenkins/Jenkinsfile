pipeline {
    agent any

    environment {
        PATH = "/opt/java/openjdk/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Install API Dependencies') {
            steps {
                dir('app/api') {
                    sh 'npm ci --omit=dev'
                }
            }
        }

        stage('Install Worker Dependencies') {
            steps {
                dir('app/worker') {
                    sh 'npm ci --omit=dev'
                }
            }
        }

        stage('Build API Image') {
            steps {
                sh 'docker build -t enterprise-sre-api:${BUILD_NUMBER} ./app/api'
            }
        }

        stage('Build Worker Image') {
            steps {
                sh 'docker build -t enterprise-sre-worker:${BUILD_NUMBER} ./app/worker'
            }
        }

        stage('Load Images into Minikube') {
            steps {
                sh '''
                    docker save enterprise-sre-api:$BUILD_NUMBER -o /tmp/api-$BUILD_NUMBER.tar
                    docker save enterprise-sre-worker:$BUILD_NUMBER -o /tmp/worker-$BUILD_NUMBER.tar

                    cat /tmp/api-$BUILD_NUMBER.tar | docker exec -i minikube ctr -n k8s.io images import -
                    cat /tmp/worker-$BUILD_NUMBER.tar | docker exec -i minikube ctr -n k8s.io images import -

                    rm -f /tmp/api-$BUILD_NUMBER.tar /tmp/worker-$BUILD_NUMBER.tar
                '''
            }
        }

        stage('Deploy to Kubernetes') {
            steps {
                sh 'kubectl set image deployment/sre-api api=enterprise-sre-api:${BUILD_NUMBER}'
                sh 'kubectl set image deployment/sre-worker worker=enterprise-sre-worker:${BUILD_NUMBER}'
                sh 'kubectl rollout status deployment/sre-api'
                sh 'kubectl rollout status deployment/sre-worker'
            }
        }
    }

    post {
        success {
            echo 'CI pipeline completed successfully.'
        }

        failure {
            echo 'CI pipeline failed. Check the stage logs.'
        }
    }
}